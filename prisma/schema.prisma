generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Employee model

model Employee {
  id             Int      @id @default(autoincrement())
  fullName       String
  email          String   @unique
  jobTitle       String
  country        String
  department     String
  salary         Float
  joiningDate    DateTime
  employmentType String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

